rules_version = '2';

// Firestore security rules for GCourse Builder (#gcoursebuilder), with role-based access control.
//
// A user's role is the "role" custom claim on their sign-in when there is one (superadmins, set
// by scripts/rbac-admin.mjs), else the role a superadmin assigned to their verified email in
// /role_assignments, else "supporter". What a role may do is the permissions list in
// /roles/{role}, which only a superadmin can change. src/rbac/PermissionContext.jsx works the role
// out the same way for the UI.
//
// Deploying this file replaces every rule in the project's (default) database: an app sharing the
// project needs its rules merged in here first. roleKeys() and permissionKeys() must match
// src/rbac/permissions.js (npm run check:rbac compares them).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function claimRole() {
      return request.auth.token.get('role', '');
    }

    function isSuperadmin() {
      return signedIn() && claimRole() == 'superadmin';
    }

    function hasVerifiedEmail() {
      return request.auth.token.get('email', '') != ''
        && request.auth.token.get('email_verified', false) == true;
    }

    // Only call after hasVerifiedEmail()
    function assignmentPath() {
      return /databases/$(database)/documents/role_assignments/$(request.auth.token.email.lower());
    }

    function roleGrants(role, perm) {
      return exists(/databases/$(database)/documents/roles/$(role))
        && perm in get(/databases/$(database)/documents/roles/$(role)).data.permissions;
    }

    // Without a claim: the role assigned to the verified email, else supporter
    function assignedRoleGrants(perm) {
      return (hasVerifiedEmail() && exists(assignmentPath())
          && roleGrants(get(assignmentPath()).data.role, perm))
        || (!(hasVerifiedEmail() && exists(assignmentPath())) && roleGrants('supporter', perm));
    }

    // True when the signed-in user's role includes `perm`. Superadmin holds every permission.
    function hasPermission(perm) {
      return signedIn() && (
        isSuperadmin()
        || (claimRole() != '' && roleGrants(claimRole(), perm))
        || (claimRole() == '' && assignedRoleGrants(perm))
      );
    }

    function roleKeys() {
      return ['superadmin', 'chancellor', 'president', 'ceo', 'coo', 'cfo', 'accounting', 'administration',
              'teacher', 'student', 'supporter'];
    }

    function permissionKeys() {
      return [
        'courses.view', 'courses.create', 'courses.publish', 'grades.view', 'grades.edit', 'classroom.manage',
        'applications.view', 'applications.review', 'applications.export', 'students.manage',
        'finance.view', 'finance.approve', 'tokens.manage', 'events.manage', 'calendar.manage',
        'ai.customize', 'faqs.edit', 'messaging.staff', 'telemetry.view',
        'users.manage', 'roles.manage', 'sheets.sync', 'api_keys.manage', 'campus_metrics.manage'
      ];
    }

    // { roleName, permissions, updatedAt, updatedBy }, stamped by the writer at the server's time.
    // Superadmin must keep every permission, so it cannot be locked out.
    function isValidRoleDoc(roleId) {
      let data = request.resource.data;
      return roleId in roleKeys()
        && data.keys().hasAll(['roleName', 'permissions', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['roleName', 'permissions', 'updatedAt', 'updatedBy'])
        && data.roleName is string && data.roleName.size() > 0 && data.roleName.size() <= 60
        && data.permissions is list
        && data.permissions.size() <= permissionKeys().size()
        && data.permissions.toSet().size() == data.permissions.size()
        && data.permissions.hasOnly(permissionKeys())
        && (roleId != 'superadmin' || data.permissions.hasAll(permissionKeys()))
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    // { email, role, assignedAt, assignedBy } at the lower-case email. Superadmin is never assigned
    // by email: it needs the claim, which only the Admin SDK can set.
    function isValidAssignment(email) {
      let data = request.resource.data;
      return email == email.lower()
        && email.matches('[^@ /]+@[^@ /]+[.][^@ /]+')
        && data.keys().hasAll(['email', 'role', 'assignedAt', 'assignedBy'])
        && data.keys().hasOnly(['email', 'role', 'assignedAt', 'assignedBy'])
        && data.email == email
        && data.role in roleKeys()
        && data.role != 'superadmin'
        && data.assignedAt == request.time
        && data.assignedBy == request.auth.uid;
    }

    // Role permissions: readable when signed in, written only by the superadmin claim
    match /roles/{roleId} {
      allow read: if signedIn();
      allow create, update: if isSuperadmin() && isValidRoleDoc(roleId);
      allow delete: if false;
    }

    // Roles given to email addresses. People can read their own; superadmins change them.
    match /role_assignments/{email} {
      allow read: if isSuperadmin()
        || hasPermission('users.manage')
        || (signedIn() && hasVerifiedEmail() && request.auth.token.email.lower() == email);
      allow create, update: if isSuperadmin() && isValidAssignment(email);
      allow delete: if isSuperadmin();
    }

    // Profiles written at sign-in (firebaseAuthService.syncUserToFirebase). People keep their own
    // profile but cannot give themselves a role or admin flag; users.manage can edit profiles but
    // not the admin flags, which only a superadmin sets.
    function protectedUserFields() {
      return ['role', 'classification', 'status', 'isSuperAdmin', 'isAdmin'];
    }

    function changes(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || hasPermission('users.manage');
      allow create: if isOwner(uid)
        && request.resource.data.get('role', 'supporter') in ['supporter', 'Supporter']
        && request.resource.data.get('classification', 'supporter') in ['supporter', 'Supporter']
        && request.resource.data.get('isSuperAdmin', false) == false
        && request.resource.data.get('isAdmin', false) == false;
      allow update: if isSuperadmin()
        || (isOwner(uid) && !changes(protectedUserFields()))
        || (hasPermission('users.manage') && !changes(['isSuperAdmin', 'isAdmin']));
      allow delete: if false;
    }

    // Older superadmin lists read at sign-in (firebaseAuthService.verifySuperadminStatus). People
    // can look up their own entry (by uid or verified email), never the whole list.
    function isOwnEntry(id) {
      return signedIn()
        && (id == request.auth.uid || (hasVerifiedEmail() && id == request.auth.token.email.lower()));
    }

    match /admins/{id} {
      allow read: if isOwnEntry(id) || isSuperadmin();
      allow create, update: if isSuperadmin();
    }

    match /superadmins/{id} {
      allow read: if isOwnEntry(id) || isSuperadmin();
      allow create, update: if isSuperadmin();
    }

    // system_config/admin lists admin emails: superadmins only
    match /system_config/{id} {
      allow read, create, update: if isSuperadmin();
    }

    // Everything else is closed.
  }
}
