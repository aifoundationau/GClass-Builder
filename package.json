{
  "name": "google-course-builder-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node dev-runner.mjs",
    "start": "node dev-runner.mjs",
    "build": "vite build --logLevel warn",
    "check:workbook": "node scripts/check-course-workbook.mjs",
    "check:rbac": "node scripts/check-rbac.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-gcoursebuilder \"node scripts/test-firestore-rules.mjs\"",
    "rbac": "node scripts/rbac-admin.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "lucide-react": "^1.59.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-admin": "^14.5.0",
    "vite": "^6.2.0"
  }
}
