{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/tokens",
      "destination": "/api/token-api"
    },
    {
      "source": "/api/tokens/:path*",
      "destination": "/api/token-api"
    },
    {
      "source": "/api/profile/sync",
      "destination": "/api/token-api"
    },
    {
      "source": "/api/exchange-rates/usd-aud",
      "destination": "/api/token-api"
    },
    {
      "source": "/api/firebase/config",
      "destination": "/api/token-api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
